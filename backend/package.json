{
  "name": "backend",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx tsx src/test-flow.ts",
    "db:up": "docker compose --env-file .env -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:reset": "docker compose -f ../docker-compose.yml down -v && rm -rf ../postgres_data",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:pull": "npx prisma db pull",
    "db:generate": "npx prisma generate",
    "db:clear": "npx tsx src/utils/clear-db-dev.ts",
    "dev": "npx tsx watch --env-file=.env src/index.ts"
  },
  "keywords": [],
  "author": "",
