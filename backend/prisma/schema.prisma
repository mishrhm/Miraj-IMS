// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique
  password String
  name     String
  role     ROLE   @default(CUSTOMER)

  productsAdded Product[]       @relation("UserProducts")
  stocksMoved   StockMovement[] @relation("UserStocksMoved")

  accountCreatedAt DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  products    Product[] @relation("CategoryProducts")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  sku         String @unique
  description String

  // Baseline Catalog Financials
  purchasePrice Decimal @db.Decimal(10, 2) // Default baseline vendor cost
  retailPrice   Decimal @db.Decimal(10, 2) // Default baseline shelf price
  sellingPrice  Decimal @db.Decimal(10, 2) // Selling price may be different due to discounts or markups
  reorderPoint  Int     @default(10) // System threshold flag for low stock alerts

  addedBy    User   @relation("UserProducts", fields: [addedByUid], references: [id])
  addedByUid String @db.Uuid

  category   Category @relation("CategoryProducts", fields: [categoryId], references: [id])
  categoryId String   @db.Uuid

  supplier   Supplier? @relation("ProductSupplier", fields: [supplierId], references: [id])
  supplierId String?   @db.Uuid

  movements StockMovement[] @relation("ProductMovement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model StockMovement {
  id        String       @id @default(uuid()) @db.Uuid
  type      MovementType
  quantity  Int          @default(1)
  timestamp DateTime     @default(now())

  product   Product @relation("ProductMovement", fields: [productId], references: [id])
  productId String  @db.Uuid

  // Dynamic Financial Transaction Ledger (Captures the exact historical reality)
  pricePerUnit   Decimal @db.Decimal(10, 2) // Actual buying/selling price for this transaction
  deliveryFee    Decimal @default(0.00) @db.Decimal(10, 2) // Transport/fulfillment overheads
  commissionPaid Decimal @default(0.00) @db.Decimal(10, 2) // Payouts to sales reps/staff

  initiatedBy    User   @relation("UserStocksMoved", fields: [initiatedByUid], references: [id])
  initiatedByUid String @db.Uuid

  supplier   Supplier? @relation("SupplierStocksMoved", fields: [supplierId], references: [id])
  supplierId String?   @db.Uuid

  @@map("stockMovements")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  contactPerson String?
  email         String   @unique
  phone         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products    Product[]       @relation("ProductSupplier")
  stocksMoved StockMovement[] @relation("SupplierStocksMoved")

  @@map("suppliers")
}

enum ROLE {
  ADMIN
  MANAGER
  SALES // Sales Team Staff
  STAFF // General staff including helpers, movers and delivery people
  CUSTOMER
}

enum MovementType {
  INCOMING // Supplier purchase, stock return
  OUTGOING // Sale, damaged goods write-off
  ADJUSTMENT // Manual override from physical audit
}
